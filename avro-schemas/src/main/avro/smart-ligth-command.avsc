{
  "type": "record",
  "name": "SmartLightCommand",
  "namespace": "com.iot.commands",
  "fields": [
    {
      "name": "commandId",
      "type": "string"
    },
    {
      "name": "deviceId",
      "type": "string"
    },
    {
      "name": "isOn",
      "type": [
        "null",
        "boolean"
      ],
      "default": null
    },
    {
      "name": "brightness",
      "type": [
        "null",
        "int"
      ],
      "default": null
    },
    {
      "name": "color",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "mode",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "SmartLightMode",
          "symbols": [
            "UNKNOWN",
            "NORMAL",
            "READING",
            "RELAX",
            "CONCENTRATE",
            "NIGHT_LIGHT",
            "SUNRISE",
            "SUNSET",
            "PARTY",
            "COLOR_CYCLE",
            "MUSIC_SYNC",
            "MOVIE",
            "AMBIENT",
            "CUSTOM"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "createdAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
